<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Register iisnode as the handler for server.mjs -->
    <handlers>
      <add name="iisnode" path="server.mjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>

        <!-- 1. Never rewrite the node entrypoint itself (avoids infinite loop) -->
        <rule name="NodeEntrypoint" stopProcessing="true">
          <match url="^server\.mjs(\/.*)?$" />
          <action type="None" />
        </rule>

        <!-- 2. Serve real static files (JS, CSS, images, sitemap, robots, etc.) directly -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 3. Everything else (all Angular routes) goes to the Node SSR app -->
        <rule name="AngularSSR">
          <match url=".*" />
          <action type="Rewrite" url="server.mjs" />
        </rule>

      </rules>
    </rewrite>

    <!-- Cache headers for the files IIS serves straight off disk.
         The StaticFiles rule above bypasses the Node app entirely, so the
         express.static maxAge never applies and responses went out with no
         Cache-Control at all — every repeat visit re-downloaded the bundles.

         A year is right by default because Angular puts a content hash in
         every bundle filename, so a changed file is a new URL. The overrides
         at the bottom cover the files that keep their name when edited. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- CRITICAL: do NOT let IIS replace responses from Node with its own error pages.
         Without this, even successful SSR renders that return non-200 will be replaced. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <iisnode
      nodeProcessCommandLine="node"
      watchedFiles="web.config;*.mjs"
      loggingEnabled="true"
      logDirectory="iisnode" />

    <!-- Block iisnode log folder from being publicly served -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="iisnode" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Overrides for files whose NAME does not change when their content does,
       so the year above would strand an old copy in browser caches. -->

  <!-- Logos and icons: renaming them on every tweak would be a chore, so a
       month rather than a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="robots.txt">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="llms.txt">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="ads.txt">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
